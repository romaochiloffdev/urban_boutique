<Window x:Class="UrbanBoutiqueAdmin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urban Boutique — Admin Login"
        Height="520" Width="440"
        Background="#eef2ff"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Border Background="White" Margin="24" CornerRadius="16" Padding="36,40">
            <Border.Effect>
                <DropShadowEffect Color="#6366f1" BlurRadius="30" Opacity="0.15" ShadowDepth="0"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo -->
                <Border Background="#6366f1" CornerRadius="14" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="🏪" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="URBAN BOUTIQUE" FontSize="22" FontWeight="ExtraBold"
                           Foreground="#0f172a" HorizontalAlignment="Center"/>
                <TextBlock Text="Admin Workspace" FontSize="13" Foreground="#64748b"
                           HorizontalAlignment="Center" Margin="0,4,0,28"/>

                <!-- Error banner -->
                <Border x:Name="borderError" Background="#fee2e2" BorderBrush="#ef4444" BorderThickness="0,0,0,0"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="txtError" Foreground="#991b1b" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold"
                           Foreground="#0f172a" Margin="0,0,0,6"/>
                <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,14">
                    <TextBox x:Name="txtUsername" Padding="10,10" FontSize="14"
                             BorderThickness="0" Background="Transparent"/>
                </Border>

                <TextBlock Text="PASSWORD" FontSize="11" FontWeight="SemiBold"
                           Foreground="#0f172a" Margin="0,0,0,6"/>
                <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,24">
                    <PasswordBox x:Name="txtPassword" Padding="10,10" FontSize="14"
                                 BorderThickness="0" Background="Transparent"/>
                </Border>

                <Button Content="SIGN IN" FontWeight="Bold" FontSize="14"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnLogin_Click" Padding="14,12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="#6366f1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4f46e5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Background="#eef2ff" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                    <TextBlock FontSize="11" Foreground="#64748b" TextAlignment="Center" TextWrapping="Wrap">
                        <Run Text="Default admin:"/>
                        <Run Text="admin" FontWeight="Bold" Foreground="#6366f1"/>
                        <Run Text="/"/>
                        <Run Text="admin123" FontWeight="Bold" Foreground="#6366f1"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
