<Window x:Class="UrbanBoutiqueAdmin.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urban Boutique — Reports"
        Height="620" Width="860"
        Background="#f1f5f9"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPIs -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <!-- Today's revenue -->
            <Border Background="White" CornerRadius="12" Padding="24" Width="320" Margin="0,0,16,0"
                    BorderBrush="#e2e8f0" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#10b981" CornerRadius="12" Width="56" Height="56" Margin="0,0,16,0">
                        <TextBlock Text="💰" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TODAY'S REVENUE" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                        <TextBlock x:Name="txtTodaySales" Text="$0.00" FontSize="28" FontWeight="ExtraBold" Foreground="#0f172a" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Today's transactions -->
            <Border Background="White" CornerRadius="12" Padding="24" Width="280"
                    BorderBrush="#e2e8f0" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#6366f1" CornerRadius="12" Width="56" Height="56" Margin="0,0,16,0">
                        <TextBlock Text="🧾" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TRANSACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                        <TextBlock x:Name="txtTodayCount" Text="0" FontSize="28" FontWeight="ExtraBold" Foreground="#0f172a" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Dead stock -->
        <Border Grid.Row="1" Background="White" CornerRadius="12"
                BorderBrush="#e2e8f0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24,18" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="⚠ Dead Stock" FontSize="16" FontWeight="Bold" Foreground="#ef4444"/>
                        <TextBlock Text="Products with stock > 0 that haven't sold in the last 30 days"
                                   FontSize="11" Foreground="#64748b" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="dgDeadStock" Grid.Row="1"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="None" HeadersVisibility="Column"
                          BorderThickness="0" RowBackground="White" AlternatingRowBackground="#fff5f5"
                          ColumnHeaderHeight="38">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#f1f5f9"/>
                            <Setter Property="Foreground" Value="#64748b"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#e2e8f0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="#9f1239"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="60"/>
                        <DataGridTextColumn Header="COLOR" Binding="{Binding Color}" Width="90"/>
                        <DataGridTextColumn Header="STOCK" Binding="{Binding StockQuantity}" Width="80"/>
                        <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat='$\{0:F2\}'}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
