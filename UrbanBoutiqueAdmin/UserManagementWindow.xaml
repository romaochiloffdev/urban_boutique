<Window x:Class="UrbanBoutiqueAdmin.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urban Boutique — Staff Management"
        Height="540" Width="860"
        Background="#f1f5f9"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Add / Reset form -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,0,16,0">
            <StackPanel Margin="24">
                <TextBlock Text="👤 Add / Reset User" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,20"/>

                <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" Foreground="#0f172a" Margin="0,0,0,6"/>
                <TextBox x:Name="txtUsername" Margin="0,0,0,14"/>

                <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="#0f172a" Margin="0,0,0,6"/>
                <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,14">
                    <PasswordBox x:Name="txtPassword" Padding="10,8" FontSize="13" BorderThickness="0" Background="Transparent"/>
                </Border>

                <TextBlock Text="ROLE" FontSize="10" FontWeight="SemiBold" Foreground="#0f172a" Margin="0,0,0,6"/>
                <ComboBox x:Name="cmbRole" Padding="10,8" FontSize="13" Margin="0,0,0,22">
                    <ComboBoxItem Content="Sales Staff" IsSelected="True"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>

                <Button Content="➕ ADD USER" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                        Padding="14,10" Cursor="Hand" Click="BtnAddUser_Click" Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="#10b981" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#059669"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="🔑 RESET PASSWORD" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                        Padding="14,10" Cursor="Hand" Click="BtnResetPassword_Click" ToolTip="Resets password for existing user">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="#f59e0b" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#d97706"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- User list -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#e2e8f0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24,18" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
                    <TextBlock Text="👥 System Users" FontSize="16" FontWeight="Bold" Foreground="#0f172a"/>
                </Border>

                <DataGrid x:Name="dgUsers" Grid.Row="1"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="None" HeadersVisibility="Column"
                          BorderThickness="0" RowBackground="White" AlternatingRowBackground="#f8fafc"
                          ColumnHeaderHeight="38">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#f1f5f9"/>
                            <Setter Property="Foreground" Value="#64748b"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#e2e8f0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding UserID}" Width="70"/>
                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
